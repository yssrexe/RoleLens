DB_USER=rolelens
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rolelens

# Compose uses db:5432 internally, regardless of DB_HOST and DB_PORT above.
APP_PORT=8000
OLLAMA_MODEL=llama3.2:latest
# Local Python defaults to localhost; Compose defaults to the Docker host.
# Uncomment to use a remote Ollama server reachable from the app container.
# OLLAMA_BASE_URL=http://your-ollama-server:11434
