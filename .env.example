# Copy to .env and choose your own database password before starting.
DB_USER=rolelens
DB_PASSWORD=replace-with-your-own-password
DB_NAME=rolelens
# Local Python connection to the Linux Compose database.
DB_HOST=127.0.0.1
DB_PORT=5433
HOST_DB_PORT=5433
APP_PORT=8000
OLLAMA_MODEL=llama3.2:latest
# Local Python only; base Compose defaults to host.docker.internal.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
